# Signing key material — never commit. Back this up yourself somewhere safe;
# losing it means you can never publish an update under the same app identity.
android.keystore
*.keystore
keystore.password.txt

# Gradle/Android build outputs — regenerated by `bubblewrap build`, not source.
.gradle/
build/
app/build/
local.properties
*.apk
*.aab
*.idsig
manifest-checksum.txt

# npm deps — reinstalled via `npm install` (patch-package reapplies the patch).
node_modules/
