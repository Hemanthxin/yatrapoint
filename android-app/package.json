{
  "name": "saafera-android",
  "private": true,
  "version": "1.0.0",
  "description": "Saafera Android app (Capacitor). Loads https://saafera.com and adds native features. See README.md.",
  "scripts": {
    "sync": "cap sync android",
    "build:debug": "cd android && gradlew.bat assembleDebug",
    "build:release": "cd android && gradlew.bat assembleRelease bundleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.3",
    "@capacitor/app": "^6.0.3",
    "@capacitor/core": "^6.2.3",
    "@capacitor/geolocation": "^6.1.1",
    "@capacitor/network": "^6.0.4",
    "@capacitor/preferences": "^6.0.4",
    "@capacitor/share": "^6.0.4",
    "@capacitor/splash-screen": "^6.0.4",
    "@capacitor/status-bar": "^6.0.3",
    "@capgo/capacitor-social-login": "^6.0.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.3"
  }
}
